import { textToSpeech } from '@kit.CoreSpeechKit';
import { BusinessError } from '@kit.BasicServicesKit';
import { hilog } from '@kit.PerformanceAnalysisKit';
import { common } from '@kit.AbilityKit';
import { OfflineVoiceResources } from './OfflineVoiceResources';

/** Distinguish a downloadable missing model from failures in the system service. */
export class VoiceSetupRequiredError extends Error {
  constructor(language: string) {
    super(`${language === 'zh-CN' ? '中文' : '英语'}语音包尚未下载，请在「我的 → 单词朗读」准备语音，下载后即可离线朗读。`);
  }
}

/** One request owns playback; a new request cancels the previous one. */
export class AudioService {
  private static instance: AudioService = new AudioService();
  private english?: textToSpeech.TextToSpeechEngine;
  private chinese?: textToSpeech.TextToSpeechEngine;
  private englishLoading?: Promise<textToSpeech.TextToSpeechEngine>;
  private chineseLoading?: Promise<textToSpeech.TextToSpeechEngine>;
  private englishDownload?: Promise<void>;
  private cancelDownloadWait?: () => void;
  private generation: number = 0;
  private engineGeneration: number = 0;
  private sequence: number = 0;
  private requestId: string = '';
  private currentEngine?: textToSpeech.TextToSpeechEngine;
  private backgroundRequest: boolean = false;
  private resolvePlayback?: () => void;
  private rejectPlayback?: (error: Error) => void;
  private timer: number = -1;
  private foregroundInterruption?: () => void;
  private onPlaybackStarted?: () => void;
  private listener: textToSpeech.SpeakListener = {
    onStart: (id: string, _response: textToSpeech.StartResponse): void => {
      if (id !== this.requestId) { return; }
      hilog.info(0x0000, 'CiyingSpeech', 'Playback started: voice=%{public}s, background=%{public}s',
        this.currentEngine === this.chinese ? 'zh-CN bilingual' : 'en-US', `${this.backgroundRequest}`);
      const callback = this.onPlaybackStarted;
      this.onPlaybackStarted = undefined;
      if (callback) { callback(); }
    },
    onComplete: (id: string, response: textToSpeech.CompleteResponse): void => {
      // type 0 is synthesis complete; type 1 means audible playback ended.
      if (id === this.requestId && response.type === 1) {
        hilog.info(0x0000, 'CiyingSpeech', 'Audible playback completed (type 1)');
        this.finish();
      }
    },
    onStop: (id: string, _response: textToSpeech.StopResponse): void => {
      if (id === this.requestId) { this.finish(new Error('语音播放被中断，请重试或继续收听')); }
    },
    onError: (id: string, code: number, message: string): void => {
      if (id !== this.requestId) { return; }
      const error = this.nativeError('语音播放失败', code, message);
      this.finish(error);
      this.invalidateCurrentEngine();
    }
  };

  static getInstance(): AudioService { return AudioService.instance; }
  initialize(context: common.Context): void {
    // Remove only caches generated by the retired bundled speech engine.
    OfflineVoiceResources.removeRetiredCaches(context).catch(() => {
      hilog.warn(0x0000, 'CiyingSpeech', 'Retired speech cache cleanup will retry next launch');
    });
  }
  setForegroundInterruption(listener?: () => void): void { this.foregroundInterruption = listener; }
  private nextId(): string { return `LexiGlow${Date.now()}${++this.sequence}`; }

  private nativeError(stage: string, code: number, message: string): Error {
    hilog.warn(0x0000, 'CiyingSpeech', '%{public}s: code=%{public}d, message=%{public}s', stage, code, message);
    let advice = '请重试，并确认设备的媒体音量已开启。';
    if (code === 1002300002) { advice = '设备语音服务不支持该语言，请检查系统语音服务。'; }
    if (code === 1002300003) { advice = '设备不支持该音色，请在「我的 → 单词朗读」下载英语音色后重试。'; }
    if (code === 1002300005) { advice = '系统语音服务或资源初始化失败，请重试或重启设备。'; }
    if (code === 1002300008) { advice = '语音包下载失败，请检查网络或系统语音下载服务后重试。'; }
    const detail = message.trim();
    return new Error(`${stage}${code ? `（${code}）` : ''}。${advice}${detail ? `\n${detail}` : ''}`);
  }

  private caughtError(stage: string, error: Error): Error {
    if (error instanceof VoiceSetupRequiredError) { return error; }
    return this.nativeError(stage, (error as BusinessError).code || 0, error.message || '系统未返回错误详情');
  }

  private async findVoice(language: string): Promise<textToSpeech.VoiceInfo | undefined> {
    let voices: textToSpeech.VoiceInfo[];
    try { voices = await textToSpeech.listVoices({ requestId: this.nextId(), online: 1 }); }
    catch (error) { throw this.caughtError('无法查询设备语音', error as Error); }
    const candidates = voices.filter((voice: textToSpeech.VoiceInfo) =>
      voice.language.replace('_', '-') === language && voice.status !== 'EOM');
    // Prefer the documented Laura / Ling Xiaoshan voice within each availability
    // group, while still using only IDs actually reported by this device.
    const preferredPerson = language === 'en-US' ? 8 : 13;
    const installed = candidates.find((voice: textToSpeech.VoiceInfo) =>
      voice.status === 'INSTALLED' && voice.person === preferredPerson) ||
      candidates.find((voice: textToSpeech.VoiceInfo) => voice.status === 'INSTALLED');
    if (installed) { return installed; }
    // Some builds omit status on built-in models. Only use reported voices, never guess an ID.
    const builtIn = candidates.find((voice: textToSpeech.VoiceInfo) =>
      !voice.status && voice.person === preferredPerson) || candidates.find((voice: textToSpeech.VoiceInfo) => !voice.status);
    if (builtIn) { return builtIn; }
    return candidates.find((voice: textToSpeech.VoiceInfo) => voice.status === 'GA' && voice.person === preferredPerson) ||
      candidates.find((voice: textToSpeech.VoiceInfo) => voice.status === 'GA');
  }

  async getEnglishVoiceStatus(): Promise<string> {
    const version = this.engineGeneration;
    const voice = await this.findVoice('en-US');
    if (version !== this.engineGeneration) { throw new Error('语音检查已取消'); }
    let failure: Error | undefined;
    if (voice && voice.status !== 'GA') {
      // A model entry alone does not prove the system service can initialize it.
      try {
        await this.prepare('en-US');
        if (version !== this.engineGeneration) { throw new Error('语音检查已取消'); }
        return 'installed';
      } catch (error) { failure = error as Error; }
    }
    if (version !== this.engineGeneration) { throw new Error('语音检查已取消'); }
    try {
      await this.prepare('zh-CN');
      if (version !== this.engineGeneration) { throw new Error('语音检查已取消'); }
      return voice?.status === 'GA' ? 'compatible' : 'compatibleOnly';
    } catch (_error) {
      if (version !== this.engineGeneration) { throw new Error('语音检查已取消'); }
      if (failure) { throw failure; }
      return voice?.status === 'GA' ? 'downloadable' : 'unavailable';
    }
  }

  private async createVoiceEngine(language: string, version: number): Promise<textToSpeech.TextToSpeechEngine> {
    const voice = await this.findVoice(language);
    if (version !== this.engineGeneration) { throw new Error('发音准备已取消'); }
    if (!voice) { throw new Error(`当前设备未提供${language === 'zh-CN' ? '中文' : '英语'}离线音色。请检查系统语音服务；模拟器可能缺少对应语音资源。`); }
    if (voice.status === 'GA') { throw new VoiceSetupRequiredError(language); }
    const params: textToSpeech.CreateEngineParams = {
      language, person: voice.person, online: 1,
      extraParams: { 'name': language === 'zh-CN' ? 'LexiGlowChinese' : 'LexiGlowEnglish',
        'style': voice.style, 'isBackStage': true }
    };
    let engine: textToSpeech.TextToSpeechEngine;
    try {
      // createEngine can throw synchronously as well as reject its promise.
      engine = await textToSpeech.createEngine(params);
    } catch (error) { throw this.caughtError('离线语音引擎初始化失败', error as Error); }
    if (version !== this.engineGeneration) {
      try { engine.shutdown(); } catch (_error) {}
      throw new Error('发音准备已取消');
    }
    try { engine.setListener(this.listener); }
    catch (error) {
      try { engine.shutdown(); } catch (_error) {}
      throw this.caughtError('无法监听系统语音播放', error as Error);
    }
    if (language === 'zh-CN') { this.chinese = engine; } else { this.english = engine; }
    return engine;
  }

  private async prepare(language: string): Promise<textToSpeech.TextToSpeechEngine> {
    const chinese = language === 'zh-CN';
    const cached = chinese ? this.chinese : this.english;
    if (cached) { return cached; }
    const pending = chinese ? this.chineseLoading : this.englishLoading;
    if (pending) { return pending; }
    const loading = this.createVoiceEngine(language, this.engineGeneration);
    if (chinese) { this.chineseLoading = loading; } else { this.englishLoading = loading; }
    try { return await loading; }
    finally {
      if (chinese && this.chineseLoading === loading) { this.chineseLoading = undefined; }
      if (!chinese && this.englishLoading === loading) { this.englishLoading = undefined; }
    }
  }

  private async prepareForPlayback(language: string): Promise<textToSpeech.TextToSpeechEngine> {
    const version = this.engineGeneration;
    try { return await this.prepare(language); }
    catch (error) {
      if (language !== 'en-US' || version !== this.engineGeneration) { throw error as Error; }
      // Huawei's texttospeech-guide demonstrates the default Chinese voice reading
      // "Hello HarmonyOS". Its built-in bilingual model works without the Laura download.
      // Keep the dedicated English voice as first choice, and never download silently.
      try { return await this.prepare('zh-CN'); }
      catch (_compatibilityError) { throw error as Error; }
    }
  }

  /** Explicit user download action; Huawei owns consent, progress and model storage. */
  async installEnglishVoice(): Promise<void> {
    if (this.englishDownload) { return this.englishDownload; }
    const loading = this.installVoice(this.engineGeneration);
    this.englishDownload = loading;
    try { await loading; }
    finally { if (this.englishDownload === loading) { this.englishDownload = undefined; } }
  }

  private async installVoice(version: number): Promise<void> {
    const voice = await this.findVoice('en-US');
    if (version !== this.engineGeneration) { throw new Error('语音准备已取消'); }
    if (!voice) { throw new Error('当前设备未提供可下载的英语音色，请检查系统语音服务。'); }
    if (voice.status === 'GA') { await this.downloadVoice(voice); }
    if (version !== this.engineGeneration) { throw new Error('语音准备已取消'); }
    await this.prepare('en-US');
  }

  private clearDownloadListeners(response: textToSpeech.DownloadResponse): void {
    try { response.off('start'); } catch (_error) {}
    try { response.off('progress'); } catch (_error) {}
    try { response.off('complete'); } catch (_error) {}
    try { response.off('cancel'); } catch (_error) {}
    try { response.off('error'); } catch (_error) {}
  }

  private downloadVoice(voice: textToSpeech.VoiceInfo): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      let settled = false;
      let response: textToSpeech.DownloadResponse | undefined;
      let idleTimer: number = -1;
      let totalTimer: number = -1;
      const finish = (error?: Error): void => {
        if (settled) { return; }
        settled = true;
        clearTimeout(idleTimer);
        clearTimeout(totalTimer);
        if (response) { this.clearDownloadListeners(response); }
        this.cancelDownloadWait = undefined;
        if (error) { reject(error); } else { resolve(); }
      };
      const resetIdleTimer = (): void => {
        if (settled) { return; }
        clearTimeout(idleTimer);
        idleTimer = setTimeout(() => {
          finish(new Error('未收到语音包下载完成信息。若已取消系统下载，请重新点击下载；若系统仍在下载，完成后返回本页或再次朗读。'));
        }, 120000);
      };
      this.cancelDownloadWait = (): void => { finish(new Error('语音准备已取消')); };
      // The initial consent dialog's Cancel button does not emit a cancel event.
      resetIdleTimer();
      totalTimer = setTimeout(() => { finish(new Error('语音包下载等待超时，请在系统下载完成后返回本页或再次朗读。')); }, 600000);
      try {
        textToSpeech.downloadVoice({ requestId: this.nextId(), language: voice.language,
          person: voice.person, style: voice.style }, (error: BusinessError, result: textToSpeech.DownloadResponse) => {
          if (settled) { return; }
          if (error) {
            // An external settings change can finish the same download between discovery and this call.
            if (error.code === 1002300010) { finish(); }
            else { finish(this.caughtError('英语语音包下载失败', error)); }
            return;
          }
          response = result;
          try {
            result.on('start', (_info: string): void => { resetIdleTimer(); });
            result.on('progress', (_info: string): void => { resetIdleTimer(); });
            result.on('complete', (_info: textToSpeech.VoiceInfo): void => { finish(); });
            result.on('cancel', (_info: string): void => { finish(new Error('英语语音包下载已取消，可再次点击下载。')); });
            result.on('error', (downloadError: BusinessError): void => {
              if (downloadError.code === 1002300010) { finish(); }
              else { finish(this.caughtError('英语语音包下载失败', downloadError)); }
            });
          } catch (listenError) { finish(this.caughtError('无法监听语音包下载', listenError as Error)); }
        });
      } catch (error) {
        if ((error as BusinessError).code === 1002300010) { finish(); }
        else { finish(this.caughtError('英语语音包下载失败', error as Error)); }
      }
    });
  }

  async prepareFlow(): Promise<void> {
    await this.prepareForPlayback('en-US');
    await this.prepare('zh-CN');
  }

  async speak(text: string, language: string = 'en-US', background: boolean = false,
    onStarted?: () => void): Promise<void> {
    const value = text.trim();
    if (value.length === 0 || value.length > 500) { throw new Error('发音内容为空或过长'); }
    if (language !== 'en-US' && language !== 'zh-CN') { throw new Error('当前仅支持英文与中文离线发音'); }
    if (!background && this.foregroundInterruption) { this.foregroundInterruption(); }
    this.stop();
    this.backgroundRequest = background;
    const version = this.generation;
    let engine: textToSpeech.TextToSpeechEngine;
    try { engine = await this.prepareForPlayback(language); }
    catch (error) {
      if (version !== this.generation) { return; }
      this.backgroundRequest = false;
      throw error as Error;
    }
    if (version !== this.generation) { return; }
    this.currentEngine = engine;
    this.requestId = this.nextId();
    this.onPlaybackStarted = onStarted;
    return new Promise<void>((resolve, reject) => {
      this.resolvePlayback = resolve;
      this.rejectPlayback = reject;
      const timeout = Math.max(30000, Math.min(120000, value.length * 250));
      this.timer = setTimeout(() => {
        this.finish(new Error('系统语音播放未能完成，请重试。请确认模拟器或设备的媒体音量已开启。'));
        this.invalidateCurrentEngine();
      }, timeout);
      try {
        const params: textToSpeech.SpeakParams = {
          requestId: this.requestId,
          // Audiobook uses media volume. Assistant avoids documented media screen-off truncation.
          extraParams: { 'playType': 1, 'volume': 1, 'languageContext': language,
            'soundChannel': background ? 3 : 12, 'queueMode': 1 }
        };
        engine.speak(value, params);
      } catch (error) {
        const cause = this.caughtError('离线语音播放失败', error as Error);
        this.finish(cause);
        this.invalidateCurrentEngine();
      }
    });
  }

  private invalidateCurrentEngine(): void {
    const engine = this.currentEngine;
    this.currentEngine = undefined;
    if (!engine) { return; }
    if (this.english === engine) { this.english = undefined; }
    if (this.chinese === engine) { this.chinese = undefined; }
    try { engine.shutdown(); } catch (_error) {}
  }

  private finish(error?: Error): void {
    if (this.timer !== -1) { clearTimeout(this.timer); this.timer = -1; }
    const resolve = this.resolvePlayback;
    const reject = this.rejectPlayback;
    this.resolvePlayback = undefined;
    this.rejectPlayback = undefined;
    this.requestId = '';
    this.onPlaybackStarted = undefined;
    this.backgroundRequest = false;
    if (error && reject) { reject(error); } else if (resolve) { resolve(); }
  }

  stop(): void {
    this.generation++;
    const engine = this.currentEngine;
    this.currentEngine = undefined;
    this.finish();
    if (engine) { try { engine.stop(); } catch (_error) {} }
  }

  stopForeground(): void { if (!this.backgroundRequest) { this.stop(); } }

  destroy(): void { this.release(); }

  release(): void {
    this.stop();
    this.engineGeneration++;
    if (this.cancelDownloadWait) { this.cancelDownloadWait(); }
    this.englishDownload = undefined;
    this.englishLoading = undefined;
    this.chineseLoading = undefined;
    if (this.english) { try { this.english.shutdown(); } catch (_error) {} this.english = undefined; }
    if (this.chinese) { try { this.chinese.shutdown(); } catch (_error) {} this.chinese = undefined; }
    this.foregroundInterruption = undefined;
  }
}
