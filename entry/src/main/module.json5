{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [
      { "name": "ohos.arkui.UIMaterial.state", "value": "enable" }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:ciying_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:ciying_icon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "singleton",
        "orientation": "auto_rotation",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryFormAbility",
        "srcEntry": "./ets/entryformability/EntryFormAbility.ets",
        "label": "$string:form_extension_name",
        "description": "$string:form_extension_description",
        "type": "form",
        "exported": true,
        "metadata": [
          { "name": "ohos.extension.form", "resource": "$profile:form_config" }
        ]
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.PUBLISH_AGENT_REMINDER" }
    ]
  }
}
