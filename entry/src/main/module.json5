{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [
      { "name": "ohos.arkui.UIMaterial.state", "value": "enable" }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:ciying_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:ciying_icon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "singleton",
        "backgroundModes": ["audioPlayback"],
        "orientation": "auto_rotation",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "entities": ["entity.system.browsable"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [{ "scheme": "lexiglow", "host": "study", "path": "plan" }]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "WordSelectionAbility",
        "srcEntry": "./ets/selectionability/WordSelectionAbility.ets",
        "type": "selection",
        "exported": true,
        "label": "$string:app_name",
        "description": "$string:module_desc"
      },
      {
        "name": "WordShareAbility",
        "srcEntry": "./ets/shareability/WordShareAbility.ets",
        "type": "share",
        "exported": true,
        "label": "$string:app_name",
        "icon": "$media:ciying_icon",
        "skills": [{
          "actions": ["ohos.want.action.sendData"],
          "uris": [{ "scheme": "file", "utd": "general.plain-text", "maxFileSupported": 1 }]
        }]
      },
      {
        "name": "EntryFormAbility",
        "srcEntry": "./ets/entryformability/EntryFormAbility.ets",
        "label": "$string:form_extension_name",
        "description": "$string:form_extension_description",
        "type": "form",
        "exported": true,
        "metadata": [
          { "name": "ohos.extension.form", "resource": "$profile:form_config" }
        ]
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:permission_microphone_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      { "name": "ohos.permission.VIBRATE" },
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING" },
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER",
        "reason": "$string:permission_reminder_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      }
    ]
  }
}
